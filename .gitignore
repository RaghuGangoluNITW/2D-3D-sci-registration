*.nrrd
*.nii
*.nii.gz
*.dcm
*.mha
*.mhd
*.raw

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.eggs/

# ── Jupyter ──
*.ipynb_checkpoints/
.ipynb_checkpoints

# ── Virtual environments ──
.venv/
venv/
env/
.conda/

# ── IDE ──
.vscode/
.idea/
*.swp
*.swo

# ── OS ──
.DS_Store
Thumbs.db

# ── Logs & temp ──
logs/*.log
logs/*.pid
nohup.out
*.tmp

